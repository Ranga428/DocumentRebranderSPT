# Copy to .env and fill in before `docker compose up -d`.
# Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the hash in single quotes so the $ signs stay literal.
APP_DOMAIN=rebrand.example.com
APP_USER=brand
APP_PASSWORD_HASH='$2a$14$replace-with-the-generated-hash'
